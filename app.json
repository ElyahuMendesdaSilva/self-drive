{
  "expo": {
    "name": "Self Drive",
    "slug": "self-drive",
    "scheme": "self-drive",
    "description": "App para gerenciamento de arquivos self host com filebrowser",
    "userInterfaceStyle": "automatic",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/d04cb5b1-e7d2-4b51-9031-0afd72e9429e",
      "checkAutomatically": "ON_LOAD"
    },
    "orientation": "default",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.elyahu.selfdrive",
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#123047",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "package": "com.elyahu_1516.selfdrive"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-updates",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": true,
            "activationRule": {
              "supportsAttachmentsWithMaxCount": 10,
              "supportsFileWithMaxCount": 10,
              "supportsImageWithMaxCount": 10,
              "supportsMovieWithMaxCount": 10
            }
          },
          "android": {
            "enabled": true,
            "singleShareMimeTypes": ["*/*"],
            "multipleShareMimeTypes": ["*/*"]
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permitir que o Self-Drive acesse suas fotos para atualizar sua foto de perfil.",
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-video",
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "DEFAULT"
        }
      ],
      "expo-audio"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d04cb5b1-e7d2-4b51-9031-0afd72e9429e"
      }
    }
  }
}
